{
  "data_processing": {
    "motion_threshold": 0.9,
    "min_position_change": 0.0001,
    "train_val_split": 0.8
  },
  
  "input_features": {
    "axis_selection": "x",
    "include_velocity": true,
    "include_acceleration": true
  },
  
  "computational_settings": {
    "jacobian_every_n_batches": 1,
    "hidden_derivative_every_n_batches": 1
  },
  
  "training_settings": {
    "num_epochs": 200,
    "early_stopping_patience": 100,
    "early_stopping_min_delta": 0.0001,
    "validation_frequency": 1,
    "optimizer_type": "adam",
    "optimizer_kwargs": null,
    "gradient_clip_value": null,
    "bidirectional": false
  },
  
  "dataloader_settings": {
    "num_workers": 0,
    "batch_size": null
  },
  
  "output_settings": {
    "verbose": 1,
    "return_history": true,
    "generate_plots": false,
    "plot_save_dir": "plots/",
    "num_plot_samples": 10,
    "error_names": ["e_enc", "e_scale"]
  }
}